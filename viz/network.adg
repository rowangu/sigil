// HAI word network — generated from seed.json + ring1.json
// 850 primes (ring 0) + 326 words (ring 1).
// Open this file in the Ampersand web IDE to walk the network:
//   node w851 is "hello"; its edges are the primes it stands on.
// Regenerate with: python3 scripts/gen_network_adg.py

graph hai_word_net;

setting memory: 8192;
setting immutable_pct: 45;
setting max_cycles: 4;

node entry entry;

