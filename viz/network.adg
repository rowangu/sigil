// SIGIL word network - generated from seed.json + ring*.json
// 850 primes (ring 0) + 326 words (ring 1) + 4218 words (ring 2).
// Outer rings sampled to 2000 nodes each for reasonable file size.
// Open this file in the Ampersand web IDE to walk the network.
// Regenerate with: python3 scripts/gen_network_adg.py

graph sigil_word_net;

setting memory: 16384;
setting immutable_pct: 60;
setting max_cycles: 4;

node entry entry;

